# ── Mainnet Production Configuration ───────────────────────────
# Ranger Delta-Neutral Funding Harvester — $20 USDC POC
#
# Usage: cp .env.mainnet .env && npm run agent

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DRIFT_ENV=mainnet-beta
STRATEGY_MODE=drift-only

# Keypair — your mainnet wallet with $20 USDC + SOL for fees
ANCHOR_WALLET=./mainnet-keypair.json

# Strategy — conservative production settings
MAX_LEVERAGE=2.0
HEALTH_RATIO_FLOOR=1.10
MAX_DRAWDOWN_PCT=3.0
MIN_FUNDING_APY=0.05
REBALANCE_INTERVAL_MS=28800000
TARGET_ASSETS=SOL,BTC,ETH

# Ranger Earn Vault (set after vault creation)
# VAULT_PUBKEY=
# DRIFT_VAULT_PUBKEY=

# AI / LLM (OpenRouter)
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4

# Monitoring
MONITOR_PORT=3000

# Telegram alerts (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Delta checks — keep strict for mainnet (true = relax for devnet only)
RELAX_DELTA_CHECKS=false
