  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "agent": "ts-node src/agent/index.ts",
    "backtest": "ts-node src/backtest/run.ts",
    "vault:init": "ts-node scripts/init-vault.ts",
    "vault:deposit": "ts-node scripts/deposit-strategy.ts",
    "vault:withdraw": "ts-node scripts/withdraw-strategy.ts",
    "vault:status": "ts-node scripts/vault-status.ts",
    "drift:status": "ts-node scripts/drift-status.ts",
    "drift:init-vault": "ts-node scripts/init-drift-vault.ts",
    "export-trades": "ts-node scripts/export-trades.ts",
    "simulate": "ts-node scripts/simulate.ts",
    "dashboard": "ts-node scripts/dashboard.ts",
    "indexer": "ts-node src/indexer/server.ts",
    "indexer:webhook:create": "ts-node scripts/create-helius-webhook.ts",
    "preflight": "ts-node scripts/preflight.ts",
    "devnet:setup": "ts-node scripts/devnet-setup.ts",
    "devnet:dry-run": "ts-node scripts/devnet-dry-run.ts",
    "devnet:strategy": "ts-node scripts/devnet-strategy-test.ts",
    "devnet:cleanup": "ts-node scripts/devnet-cleanup.ts",
    "devnet:llm-test": "ts-node scripts/test-llm-advisor.ts",
    "launch:preflight": "ts-node scripts/mainnet-launch.ts",
    "launch:preflight:devnet": "ts-node scripts/mainnet-launch.ts -- --devnet",
