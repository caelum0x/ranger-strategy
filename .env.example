# ── Solana ──────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Helius RPC — required for priority fee estimation (sendAndConfirmOptimisedTx)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Keypair (use ONE of these):
# Option 1: Path to keypair JSON file (recommended, matches Drift convention)
ANCHOR_WALLET=~/.config/solana/my-keypair.json
# Option 2: Base58-encoded private key
# SOLANA_PRIVATE_KEY=your_base58_private_key
# Option 3: Cobo MPC wallet (production — set API key to enable)
# COBO_API_KEY=your_cobo_api_key
# COBO_API_SECRET=your_cobo_api_secret

# ── Ranger Earn (Voltr) ──────────────────────────────────────
RANGER_API_URL=https://api.voltr.xyz
VAULT_PUBKEY=your_vault_public_key

# ── Drift ──────────────────────────────────────────────────────
DRIFT_ENV=mainnet-beta
# Drift Vault address (set after running `npm run drift:init-vault`)
# DRIFT_VAULT_PUBKEY=your_drift_vault_address
DRIFTBEAR_CUSTOM_ADAPTOR_PROGRAM=G5RgbPTWyYePXebLMsP6sZTQKkKZhwP3Zn1CnSGhPnPi

# ── Binance (only needed when STRATEGY_MODE=cross-venue) ─────
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret
BINANCE_TESTNET=false

# ── Strategy Config ──────────────────────────────────────────
# "drift-only" = fully on-chain (spot+perp on Drift, seedable by vault)
# "cross-venue" = spot on Drift + perp on Binance (requires CEX capital)
STRATEGY_MODE=drift-only
MAX_LEVERAGE=2.0
HEALTH_RATIO_FLOOR=1.10
MAX_DRAWDOWN_PCT=3.0
# Minimum annualized funding rate to trade (below this, skip the asset)
MIN_FUNDING_APY=0.05
REBALANCE_INTERVAL_MS=28800000
JUPITER_SWAP_SLIPPAGE_BPS=100
TARGET_ASSETS=SOL,BTC,ETH

# ── Liquidator ─────────────────────────────────────────────────
LIQUIDATION_SCAN_INTERVAL_MS=5000
LIQUIDATION_MAX_USERS_PER_TICK=5
LIQUIDATION_TAKEOVER_PCT=0.25
LIQUIDATION_AUTO_DERISK=true
LIQUIDATION_DRY_RUN=true
LIQUIDATION_SUBACCOUNTS=0
LIQUIDATION_DEFAULT_SUBACCOUNT_ID=0
# format: marketIndex:subaccountId,marketIndex:subaccountId
LIQUIDATION_PERP_SUBACCOUNT_MAP=
LIQUIDATION_SPOT_SUBACCOUNT_MAP=
LIQUIDATION_PRIORITY_FEE_MULTIPLIER=1.2
LIQUIDATION_MAX_PRIORITY_FEE_MICROLAMPORTS=250000
LIQUIDATION_FALLBACK_PRIORITY_FEE_MICROLAMPORTS=50000
LIQUIDATION_COMPUTE_UNITS=1400000

# ── AI Agent ──────────────────────────────────────────────────
FUNDING_PREDICTION_LOOKBACK_HOURS=168
REGIME_DETECTION_WINDOW=48
